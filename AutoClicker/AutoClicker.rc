// AutoClicker resource script
#include "resource.h"
#include "winres.h"

// Application icon (lowest ID value placed first so the application icon
// remains consistent on all systems)
IDI_ICON1               ICON                    "icon.ico"

// Embedded MCCombatStatusJni.dll (extracted to %%TEMP%% at startup)
IDR_MC_DLL              RCDATA                  "MCCombatStatusJni.dll"
