// AutoClicker resource script
#include "resource.h"
#include "winres.h"

// Application icon (lowest ID value placed first so the application icon
// remains consistent on all systems)
IDI_ICON1               ICON                    "icon.ico"

// Embedded MCCombatStatusJni.dll (XOR 0x5A encrypted by tools/enc_dll.ps1;
// decrypted in memory at runtime, manual-mapped - never written to disk)
IDR_MC_DLL              RCDATA                  "mcstatus_enc.dat"
